{
  "name": "classquest-cloud-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "LocalStack-based AWS cloud prototype demonstrating the ClassQuest three-tier migration architecture (INFS803).",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b packages/shared services/app-tier services/web-tier services/worker",
    "test": "vitest run",
    "test:all": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:api": "vitest run tests/api",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:acceptance": "vitest run --config vitest.acceptance.config.ts",
    "lint": "eslint . --ext .ts,.tsx",
    "stack:up": "docker compose up -d --build",
    "stack:down": "docker compose down -v",
    "stack:logs": "docker compose logs -f",
    "stack:scale-workers": "docker compose up -d --scale worker=3",
    "demo:seed": "node tests/scripts/demo-seed.js",
    "demo:400-burst": "node tests/scripts/http400-burst.js"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
