# ======================================================================
# ClassQuest Cloud Prototype — environment template
# Copy to .env and adjust. NEVER commit a real .env (see .gitignore).
# For the LocalStack demo, the defaults below work as-is.
# ======================================================================

# --- Deployment target: "localstack" (demo) or "aws" (real cloud) ---
CLOUD_TARGET=localstack
AWS_REGION=ap-southeast-2

# --- AWS endpoint (LocalStack). Leave blank/unset for real AWS. ---
AWS_ENDPOINT_URL=http://localstack:4566

# Browser-reachable S3 endpoint used ONLY to sign presigned download URLs.
# Internal calls use AWS_ENDPOINT_URL (http://localstack:4566); the browser
# cannot resolve the "localstack" hostname, so presigned links must point at a
# host-reachable address. Leave blank/unset for real AWS.
S3_PUBLIC_ENDPOINT=http://localhost:4566

# --- AWS credentials ---
# For LocalStack these are dummy values and are NOT real secrets.
# For real AWS, DO NOT put long-lived keys here — use an IAM role /
# instance profile (credential-less, per report section 6.2 / 6.10).
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- Cloud resource names (must match Terraform) ---
ENV_NAME=dev
S3_BUCKET=classquest-media-assets-dev
SQS_QUEUE_NAME=classquest-asset-processing
SQS_DLQ_NAME=classquest-asset-processing-dlq
SNS_TOPIC_NAME=classquest-admin-alerts
CW_LOG_GROUP=/aws/alb/classquest-dev
CW_NAMESPACE=ClassQuest/Prototype
ADMIN_ALERT_EMAIL=sysadmin@classquest.example

# --- App IAM role (credential-less service access) ---
APP_ROLE_ARN=arn:aws:iam::000000000000:role/classquest-app-role
WEB_ROLE_ARN=arn:aws:iam::000000000000:role/classquest-web-role

# --- MySQL (RDS-for-MySQL stand-in) ---
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=classquest
MYSQL_USER=classquest_app
# Local demo password only. In prod this comes from AWS Secrets Manager (report 6.10).
MYSQL_PASSWORD=change-me-locally
MYSQL_ROOT_PASSWORD=change-me-root-locally

# --- Auth ---
# Local demo secret only. In prod load from Secrets Manager / SSM.
JWT_SECRET=local-dev-jwt-secret-change-me
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=10

# --- Service ports / wiring ---
APP_TIER_PORT=4000
WEB_TIER_PORT=8080
APP_TIER_URL=http://app-tier:4000

# --- Demo mode (LocalStack academic prototype) ---
# Enables /demo/* (teacher/admin only, except /demo/bad-request) and creates the
# sample accounts at startup. Defaults to true for localstack, false for aws.
DEMO_MODE=true

# --- Worker tuning ---
# Fallback only: the worker uses the queue's redrive maxReceiveCount (Terraform: 3).
WORKER_MAX_ATTEMPTS=3
WORKER_POLL_WAIT_SECONDS=5
WORKER_VISIBILITY_TIMEOUT=30
# Delay before a failed message is redelivered (and, after the final attempt, redriven to the DLQ).
WORKER_RETRY_DELAY_SECONDS=5

# --- Monitoring thresholds (report 2.2.8 / 7.7) ---
HTTP_400_ALARM_THRESHOLD=50
HTTP_400_ALARM_PERIOD_SECONDS=60

# --- Edge rate limiting (WAF/Shield stand-in, report 6.11) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=2000

# --- Upload constraints (report section 13 error handling) ---
MAX_UPLOAD_BYTES=52428800
