#!/bin/bash
# ======================================================================
# ClassQuest EC2 bootstrap (cloud-init) — rendered by Terraform compute.tf.
# Installs Docker + Compose, clones the repo, writes a production .env and
# brings up app-tier + worker + web-tier against the real AWS resources.
# No AWS credentials are written here: the instance uses its IAM role.
# ======================================================================
set -xo pipefail

# Log to a file AND the serial console (so `aws ec2 get-console-output` shows
# progress and any failure, even without SSH access).
exec > >(tee /var/log/classquest-bootstrap.log | tee /dev/console) 2>&1

# Small retry helper: retry a command up to 5 times with a short backoff.
retry() {
  local n=1
  until "$@"; do
    if [ "$n" -ge 5 ]; then
      echo "FATAL: command failed after $n attempts: $*"
      return 1
    fi
    echo "attempt $n failed: $* — retrying in 10s"
    n=$((n + 1))
    sleep 10
  done
}

echo "=== ClassQuest bootstrap starting at $(date -u) ==="

# ---- 1. Install Docker + git ----
# dnf update is best-effort: a transient mirror hiccup must not abort the run.
dnf update -y || echo "WARN: dnf update failed (continuing)"
retry dnf install -y docker git
systemctl enable --now docker

# Wait until the Docker daemon actually answers before using it.
retry docker info

# ---- Docker CLI plugins: buildx (required by `compose --build`) + compose ----
# `docker compose build` delegates to buildx, so buildx must be present or the
# build fails with "compose build requires buildx 0.17.0 or later".
mkdir -p /usr/libexec/docker/cli-plugins

# buildx
if ! retry curl -fSL "https://github.com/docker/buildx/releases/latest/download/buildx-linux-amd64" \
      -o /usr/libexec/docker/cli-plugins/docker-buildx; then
  echo "WARN: buildx download failed; trying dnf docker-buildx-plugin"
  dnf install -y docker-buildx-plugin || true
fi
chmod +x /usr/libexec/docker/cli-plugins/docker-buildx 2>/dev/null || true

# compose
if ! retry curl -fSL "https://github.com/docker/compose/releases/latest/download/docker-compose-linux-x86_64" \
      -o /usr/libexec/docker/cli-plugins/docker-compose; then
  echo "WARN: compose plugin download failed; trying dnf docker-compose-plugin"
  dnf install -y docker-compose-plugin || true
fi
chmod +x /usr/libexec/docker/cli-plugins/docker-compose 2>/dev/null || true

docker buildx version || { echo "FATAL: docker buildx unavailable"; exit 1; }
docker compose version || { echo "FATAL: docker compose plugin unavailable"; exit 1; }

usermod -aG docker ec2-user || true

# ---- 2. Clone the application repository ----
APP_DIR=/opt/classquest
rm -rf "$APP_DIR"
retry git clone --branch "${git_branch}" --depth 1 "${git_repo}" "$APP_DIR"
cd "$APP_DIR"

# Fail loudly if the AWS override is missing (e.g. not pushed to the branch).
if [ ! -f docker-compose.aws.yml ]; then
  echo "FATAL: docker-compose.aws.yml not found in the cloned repo (branch ${git_branch}). Push it to the branch and re-launch."
  exit 1
fi

# ---- 3. Write the production .env (cloud_target = aws) ----
# AWS_ENDPOINT_URL and S3_PUBLIC_ENDPOINT are intentionally left UNSET so the
# AWS SDK targets real regional endpoints. Credentials come from the instance
# role, not from this file.
cat > "$APP_DIR/.env" <<ENV
CLOUD_TARGET=aws
AWS_REGION=${aws_region}
ENV_NAME=${env_name}

S3_BUCKET=${s3_bucket}
SQS_QUEUE_NAME=${sqs_queue_name}
SQS_DLQ_NAME=${sqs_dlq_name}
SNS_TOPIC_NAME=${sns_topic_name}
CW_LOG_GROUP=${cw_log_group}
CW_NAMESPACE=${cw_namespace}
ADMIN_ALERT_EMAIL=${admin_email}

MYSQL_HOST=${mysql_host}
MYSQL_PORT=${mysql_port}
MYSQL_DATABASE=${mysql_database}
MYSQL_USER=${mysql_user}
MYSQL_PASSWORD=${mysql_password}

JWT_SECRET=${jwt_secret}
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=10

APP_TIER_PORT=4000
WEB_TIER_PORT=8080
APP_TIER_URL=http://app-tier:4000

DEMO_MODE=false

WORKER_MAX_ATTEMPTS=3
WORKER_POLL_WAIT_SECONDS=5
WORKER_VISIBILITY_TIMEOUT=30
WORKER_RETRY_DELAY_SECONDS=5

HTTP_400_ALARM_THRESHOLD=${http_400_thresh}
HTTP_400_ALARM_PERIOD_SECONDS=${http_400_period}

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=2000

MAX_UPLOAD_BYTES=${max_upload}
ENV

# ---- 4. Launch the stack (AWS override drops localstack/mysql/terraform) ----
# Building three images from source can be slow on first boot; retry wraps a
# transient network failure during image pulls / npm install.
retry docker compose -f docker-compose.yml -f docker-compose.aws.yml up -d --build

echo "=== docker compose ps ==="
docker compose -f docker-compose.yml -f docker-compose.aws.yml ps
echo "=== ClassQuest bootstrap complete at $(date -u) ==="
